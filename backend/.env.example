# ============================================================
# SALIN FILE INI KE .env DAN ISI DENGAN KREDENSIAL ANDA
# Copy this file to .env and fill in your credentials
# ============================================================

# Database (Supabase PostgreSQL) Configuration
DB_HOST=your-supabase-host.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_supabase_db_password
DB_NAME=postgres

# Server Configuration
PORT=3000

# MQTT Configuration
MQTT_HOST=broker.emqx.io
MQTT_PORT=1883
MQTT_CLIENT_ID=smart_aqua_backend
MQTT_USER=
MQTT_PASSWORD=

# Telegram Bot Configuration
# Buat bot baru via @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
